# CryptoAnalyzer Environment Variables
# Copy this file to .env and modify as needed

# Application
APP_NAME=CryptoAnalyzer API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60

# Model Paths (relative to /app in container)
MODEL_CHECKPOINT_DIR=/app/models/checkpoints
SEQUENCE_TENSOR_DIR=/app/data/processed/tensors
EXPERIMENT_RESULTS_DIR=/app/experiments/results

# Data
RAW_DATA_PATH=/app/data/raw/btcusdt_5m_raw.csv
FEATURES_DATA_PATH=/app/data/processed/btcusdt_5m_features.csv

# Binance API
BINANCE_BASE_URL=https://api.binance.com/api/v3
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=5m
BINANCE_LIMIT=1000

# Prediction Settings
PREDICTION_HORIZON=12
LOOKBACK_WINDOW=60
DEFAULT_EXPERIMENT=EXP_D_FULL
DEFAULT_MODEL=xgboost

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000